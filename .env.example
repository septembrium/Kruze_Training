# Database Configuration
# Supabase PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
# You can find this in your Supabase project settings under "Database" > "Connection String"
# Use the "Connection pooling" string for better performance in serverless environments
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Configuration (Server-side)
# Get these from your Supabase project settings under "API"
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[YOUR-ANON-KEY]
# Optional: Service role key for admin operations (keep this secret!)
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-KEY]

# Supabase Configuration (Client-side - Vite)
# These are exposed to the frontend, so only use public keys
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=[YOUR-ANON-KEY]

# Backend API URL (Client-side - Vite)
# PRODUCTION: Leave this EMPTY or unset to use /api proxy (recommended for Vercel)
# DEVELOPMENT: Can point to your Cloud Run backend for local testing
# VITE_API_URL=https://kruzeapp-76726500838.europe-west1.run.app

# Server Configuration
NODE_ENV=development
PORT=5000

# Session Configuration
SESSION_SECRET=[GENERATE-A-RANDOM-SECRET-KEY]

# Replit Authentication (OIDC)
REPLIT_DOMAINS=your-domain.repl.co
REPL_ID=[YOUR-REPL-ID]
REPL_IDENTITY=[YOUR-REPL-IDENTITY]
WEB_REPL_RENEWAL=[YOUR-WEB-REPL-RENEWAL]
ISSUER_URL=https://replit.com/oidc

# Resend Email Service
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=[YOUR-RESEND-API-KEY]

# CORS Configuration
# Comma-separated list of allowed origins for production
ALLOWED_ORIGINS=https://your-domain.com,https://another-domain.com
